        const faqData = [
            { q: 'How do I unlock new hypercars?', a: 'Progress through Career Mode, complete weekly missions, or earn championship prize money to purchase vehicles from the showroom.' },
            { q: 'Are the physics arcade or simulation?', a: 'NITRO X uses a hybrid Apex Physics Engine featuring realistic weight transfer, tire grip coefficients, and customizable assists.' },
