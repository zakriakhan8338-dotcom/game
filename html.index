        <!-- ================= PAGE 11: ABOUT THE GAME ================= -->
        <div id="page-about" class="page-section hidden">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">
                <div class="text-center">
                    <span class="text-racingred font-heading text-sm uppercase tracking-widest block mb-2">Our Vision</span>
                    <h1 class="font-heading text-4xl sm:text-6xl font-bold uppercase tracking-tight mb-6">About NITRO X</h1>
                    <p class="text-titanium text-lg leading-relaxed">
                        NITRO X was forged by a passionate team of automotive engineers, physics simulation experts, and AAA game veterans. Our mission is to build the ultimate uncompromising racing platform for enthusiasts worldwide.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-8">
                    <div class="glass-panel p-8 rounded-2xl border border-white/10">
                        <h3 class="font-heading text-2xl font-bold uppercase mb-4 text-racingred">Apex Physics Engine</h3>
                        <p class="text-titanium text-sm leading-relaxed">
                            Our proprietary physics pipeline simulates tire deformation, weight transfer, aerodynamic downforce, and surface friction at 1,000Hz. Every supercar behaves with absolute mechanical fidelity.
                        </p>
                    </div>
                    <div class="glass-panel p-8 rounded-2xl border border-white/10">
                        <h3 class="font-heading text-2xl font-bold uppercase mb-4 text-racingred">Cinematic Graphics</h3>
                        <p class="text-titanium text-sm leading-relaxed">
