<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NITRO X — Built For Speed. Made For Legends.</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        obsidian: '#090909',
                        graphite: '#191919',
                        surface: '#222222',
                        titanium: '#BFC3C7',
                        racingred: '#E63935',
                        racingredhover: '#d02e2a'
                    },
                    fontFamily: {
                        heading: ['Space Grotesk', 'sans-serif'],
                        body: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Three.js for 3D car previews / game effects -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #090909;
            color: #FFFFFF;
            overflow-x: hidden;
        }
        h1, h2, h3, h4, h5, h6, .font-heading {
            font-family: 'Space Grotesk', sans-serif;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #090909;
        }
        ::-webkit-scrollbar-thumb {
            background: #2a2a2a;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #E63935;
        }
        .glass-panel {
            background: rgba(25, 25, 25, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .glow-red {
            box-shadow: 0 0 35px rgba(230, 57, 53, 0.35);
        }
        .text-glow {
            text-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
        }
        @keyframes pulseSlow {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.02); }
        }
        .animate-pulse-slow {
            animation: pulseSlow 4s infinite ease-in-out;
        }
    </style>
</head>
<body class="bg-obsidian text-white min-h-screen flex flex-col selection:bg-racingred selection:text-white">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col space-y-3 pointer-events-none"></div>

    <!-- Persistent Navigation Bar -->
    <header class="fixed top-0 left-0 w-full z-40 bg-obsidian/90 backdrop-blur-md border-b border-white/10 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Logo -->
            <div class="flex items-center space-x-3 cursor-pointer" onclick="switchPage('home')">
                <div class="w-10 h-10 rounded bg-racingred flex items-center justify-center font-heading font-bold text-xl italic tracking-tighter glow-red">
                    NX
                </div>
                <div>
                    <span class="font-heading text-xl font-bold tracking-widest block leading-none">NITRO X</span>
                    <span class="text-[10px] text-titanium tracking-widest uppercase block mt-1">Apex Racing Platform</span>
                </div>
            </div>

            <!-- Desktop Nav Links -->
            <nav class="hidden xl:flex items-center space-x-7 text-sm font-medium text-titanium">
                <button onclick="switchPage('home')" class="nav-link hover:text-white transition-colors py-2 active" data-page="home">Home</button>
                <button onclick="switchPage('world')" class="nav-link hover:text-white transition-colors py-2" data-page="world">Game World</button>
                <button onclick="switchPage('collection')" class="nav-link hover:text-white transition-colors py-2" data-page="collection">Showroom</button>
                <button onclick="switchPage('garage')" class="nav-link hover:text-white transition-colors py-2" data-page="garage">Garage</button>
                <button onclick="switchPage('modes')" class="nav-link hover:text-white transition-colors py-2" data-page="modes">Racing Modes</button>
                <button onclick="switchPage('championships')" class="nav-link hover:text-white transition-colors py-2" data-page="championships">Esports</button>
                <button onclick="switchPage('leaderboard')" class="nav-link hover:text-white transition-colors py-2" data-page="leaderboard">Leaderboard</button>
                <button onclick="switchPage('dashboard')" class="nav-link hover:text-white transition-colors py-2" data-page="dashboard">Dashboard</button>
                <button onclick="switchPage('community')" class="nav-link hover:text-white transition-colors py-2" data-page="community">Clubs</button>
                <button onclick="switchPage('news')" class="nav-link hover:text-white transition-colors py-2" data-page="news">News</button>
            </nav>

            <!-- Right Actions -->
            <div class="flex items-center space-x-4">
                <button onclick="openGameModal()" class="hidden sm:flex items-center space-x-2 bg-racingred hover:bg-racingredhover text-white px-5 py-2.5 rounded font-heading font-semibold uppercase tracking-wider text-sm transition-all shadow-lg glow-red">
                    <i class="fa-solid fa-gamepad"></i>
                    <span>Play Now</span>
                </button>
                <button onclick="switchPage('login')" class="hidden md:flex items-center space-x-2 bg-graphite hover:bg-surface text-titanium hover:text-white px-4 py-2.5 rounded font-medium text-sm transition-all border border-white/10">
                    <i class="fa-regular fa-user"></i>
                    <span id="nav-user-label">Sign In</span>
                </button>
                <button onclick="switchPage('settings')" class="text-titanium hover:text-white p-2.5 rounded bg-graphite/50 hover:bg-graphite transition-all border border-white/10">
                    <i class="fa-solid fa-gear"></i>
                </button>
                <!-- Mobile Menu Button -->
                <button onclick="toggleMobileMenu()" class="xl:hidden text-titanium hover:text-white p-2.5">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Nav Drawer -->
        <div id="mobile-menu" class="hidden xl:hidden bg-graphite border-b border-white/10 px-6 py-4 space-y-3">
            <button onclick="switchPage('home'); toggleMobileMenu();" class="block w-full text-left py-2 font-medium text-titanium hover:text-white">Home</button>
            <button onclick="switchPage('world'); toggleMobileMenu();" class="block w-full text-left py-2 font-medium text-titanium hover:text-white">Game World</button>
            <button onclick="switchPage('collection'); toggleMobileMenu();" class="block w-full text-left py-2 font-medium text-titanium hover:text-white">Showroom</button>
            <button onclick="switchPage('garage'); toggleMobileMenu();" class="block w-full text-left py-2 font-medium text-titanium hover:text-white">Garage & Customizer</button>
            <button onclick="switchPage('modes'); toggleMobileMenu();" class="block w-full text-left py-2 font-medium text-titanium hover:text-white">Racing Modes</button>
            <button onclick="switchPage('championships'); toggleMobileMenu();" class="block w-full text-left py-2 font-medium text-titanium hover:text-white">Esports & Tournaments</button>
            <button onclick="switchPage('leaderboard'); toggleMobileMenu();" class="block w-full text-left py-2 font-medium text-titanium hover:text-white">Global Leaderboard</button>
            <button onclick="switchPage('dashboard'); toggleMobileMenu();" class="block w-full text-left py-2 font-medium text-titanium hover:text-white">Player Dashboard</button>
            <button onclick="switchPage('community'); toggleMobileMenu();" class="block w-full text-left py-2 font-medium text-titanium hover:text-white">Racing Clubs</button>
            <button onclick="switchPage('news'); toggleMobileMenu();" class="block w-full text-left py-2 font-medium text-titanium hover:text-white">News & Updates</button>
            <button onclick="switchPage('about'); toggleMobileMenu();" class="block w-full text-left py-2 font-medium text-titanium hover:text-white">About Game</button>
            <button onclick="switchPage('support'); toggleMobileMenu();" class="block w-full text-left py-2 font-medium text-titanium hover:text-white">Support & FAQ</button>
            <div class="pt-3 border-t border-white/10 flex space-x-3">
                <button onclick="openGameModal(); toggleMobileMenu();" class="flex-1 bg-racingred text-white py-2 rounded text-center font-heading font-semibold uppercase">Play Now</button>
                <button onclick="switchPage('login'); toggleMobileMenu();" class="flex-1 bg-graphite border border-white/10 text-white py-2 rounded text-center font-medium">Account</button>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-grow pt-20">

        <!-- ================= PAGE 1: HOME ================= -->
        <div id="page-home" class="page-section">
            <!-- Hero Section -->
            <section class="relative min-h-[92vh] flex items-center justify-center overflow-hidden">
                <!-- Background Image / Cinematic Visual -->
                <div class="absolute inset-0 z-0">
                    <img src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=2000&q=85" alt="Supercar Hero" class="w-full h-full object-cover object-center filter brightness-50 contrast-125 scale-105 animate-pulse-slow">
                    <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-obsidian/40 to-transparent"></div>
                    <div class="absolute inset-0 bg-gradient-to-r from-obsidian/80 via-transparent to-obsidian/80"></div>
                </div>

                <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center py-24">
                    <div class="inline-flex items-center space-x-2 bg-graphite/80 backdrop-blur border border-white/10 px-4 py-1.5 rounded-full mb-6">
                        <span class="w-2.5 h-2.5 rounded-full bg-racingred animate-ping"></span>
                        <span class="text-xs uppercase tracking-widest text-titanium font-semibold">Season 4: Apex Overdrive Live</span>
                    </div>

                    <h1 class="font-heading text-5xl sm:text-7xl lg:text-8xl font-bold tracking-tight text-white uppercase text-glow mb-6">
                        Built For Speed.<br><span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-titanium to-racingred">Made For Legends.</span>
                    </h1>

                    <p class="max-w-2xl mx-auto text-lg sm:text-xl text-titanium font-light mb-10 leading-relaxed">
                        Push the ultimate limits of high-performance physics, master extreme global circuits, customize legendary hypercars, and write your racing legacy.
                    </p>

                    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                        <button onclick="openGameModal()" class="w-full sm:w-auto bg-racingred hover:bg-racingredhover text-white px-8 py-4 rounded font-heading font-bold text-base uppercase tracking-wider transition-all shadow-xl glow-red flex items-center justify-center space-x-3">
                            <i class="fa-solid fa-flag-checkered text-lg"></i>
                            <span>Start Racing</span>
                        </button>
                        <button onclick="switchPage('world')" class="w-full sm:w-auto bg-graphite/80 hover:bg-surface text-white border border-white/20 px-8 py-4 rounded font-heading font-bold text-base uppercase tracking-wider transition-all flex items-center justify-center space-x-3">
                            <i class="fa-solid fa-earth-americas text-lg text-titanium"></i>
                            <span>Explore The World</span>
                        </button>
                    </div>

                    <!-- Live Player Counter -->
                    <div class="mt-16 inline-flex items-center space-x-4 bg-graphite/60 backdrop-blur px-6 py-3 rounded-xl border border-white/10">
                        <div class="flex -space-x-2">
                            <img class="w-8 h-8 rounded-full border-2 border-obsidian" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80" alt="User">
                            <img class="w-8 h-8 rounded-full border-2 border-obsidian" src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=100&q=80" alt="User">
                            <img class="w-8 h-8 rounded-full border-2 border-obsidian" src="https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?auto=format&fit=crop&w=100&q=80" alt="User">
                        </div>
                        <div class="text-left">
                            <div class="text-xs text-titanium uppercase tracking-wider">Active Racers Online</div>
                            <div class="text-sm font-heading font-bold text-white"><span id="live-counter" class="text-racingred">48,291</span> Drivers on Track</div>
                        </div>
                    </div>
                </div>

                <!-- Scroll Indicator -->
                <div class="absolute bottom-6 left-1/2 transform -translate-x-1/2 flex flex-col items-center text-titanium animate-bounce">
                    <span class="text-[10px] tracking-widest uppercase mb-1">Scroll Down</span>
                    <i class="fa-solid fa-chevron-down text-xs"></i>
                </div>
            </section>

            <!-- Featured Race Section -->
            <section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
                    <div>
                        <span class="text-racingred font-heading text-sm uppercase tracking-widest block mb-2">Featured Showdown</span>
                        <h2 class="font-heading text-4xl sm:text-5xl font-bold uppercase tracking-tight">The Midnight Apex Grand Prix</h2>
                    </div>
                    <button onclick="switchPage('championships')" class="mt-4 md:mt-0 text-sm font-semibold text-titanium hover:text-white flex items-center space-x-2 group">
                        <span>View All Tournaments</span>
                        <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                    </button>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    <!-- Featured Banner Card -->
                    <div class="lg:col-span-2 relative rounded-2xl overflow-hidden group min-h-[420px] flex flex-col justify-end p-8 border border-white/10">
                        <div class="absolute inset-0 z-0">
                            <img src="https://images.unsplash.com/photo-1544829099-b9a0c07fad1a?auto=format&fit=crop&w=1200&q=85" alt="Neon City Race" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
                            <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-obsidian/40 to-transparent"></div>
                        </div>
                        <div class="relative z-10">
                            <span class="bg-racingred text-white text-xs font-heading font-bold px-3 py-1 rounded uppercase tracking-wider mb-4 inline-block">High Stakes</span>
                            <h3 class="font-heading text-3xl font-bold uppercase mb-2">Neon Skyline Elimination</h3>
                            <p class="text-titanium text-sm max-w-xl mb-6">Race through the rain-soaked neon avenues of Tokyo at 240+ MPH. Avoid civilian traffic, drift the harbor corners, and claim the $50,000 Grand Prize.</p>
                            <div class="flex flex-wrap items-center gap-4 text-xs font-semibold text-titanium">
                                <span class="bg-graphite/80 px-3 py-1.5 rounded border border-white/10"><i class="fa-solid fa-trophy text-yellow-500 mr-2"></i> $50,000 Pool</span>
                                <span class="bg-graphite/80 px-3 py-1.5 rounded border border-white/10"><i class="fa-solid fa-gauge-high text-racingred mr-2"></i> Class S Hypercars</span>
                                <span class="bg-graphite/80 px-3 py-1.5 rounded border border-white/10"><i class="fa-solid fa-clock mr-2"></i> Starts in 2h 15m</span>
                            </div>
                        </div>
                    </div>

                    <!-- Latest Update & Quick Stats -->
                    <div class="space-y-6 flex flex-col justify-between">
                        <div class="glass-panel p-6 rounded-2xl border border-white/10">
                            <div class="flex items-center justify-between mb-4">
                                <span class="text-xs uppercase tracking-widest text-racingred font-heading font-bold">Update v2.4.0</span>
                                <span class="text-xs text-titanium">May 2026</span>
                            </div>
                            <h4 class="font-heading text-xl font-bold mb-2">The Alpine Frost Expansion</h4>
                            <p class="text-titanium text-sm mb-4">Conquer treacherous icy hairpins, dynamic snowfall physics, and 3 new Italian V12 monsters.</p>
                            <button onclick="switchPage('news')" class="text-sm font-semibold text-white hover:text-racingred flex items-center space-x-2">
                                <span>Read Patch Notes</span>
                                <i class="fa-solid fa-arrow-right text-xs"></i>
                            </button>
                        </div>

                        <div class="glass-panel p-6 rounded-2xl border border-white/10 bg-gradient-to-br from-graphite to-obsidian">
                            <h4 class="font-heading text-lg font-bold mb-4 uppercase">Weekly Milestone</h4>
                            <div class="space-y-3 text-sm">
                                <div class="flex justify-between text-titanium">
                                    <span>Global Drift Distance</span>
                                    <span class="text-white font-semibold">4.8M Miles</span>
                                </div>
                                <div class="w-full bg-surface rounded-full h-2">
                                    <div class="bg-racingred h-2 rounded-full" style="width: 78%"></div>
                                </div>
                                <div class="flex justify-between text-xs text-titanium pt-1">
                                    <span>Goal: 6M Miles</span>
                                    <span class="text-racingred">78% Completed</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Popular Cars Preview Grid -->
            <section class="py-20 bg-graphite/30 border-y border-white/10">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
                        <div>
                            <span class="text-racingred font-heading text-sm uppercase tracking-widest block mb-2">Apex Garage Showcase</span>
                            <h2 class="font-heading text-4xl sm:text-5xl font-bold uppercase tracking-tight">Most Driven Hypercars</h2>
                        </div>
                        <button onclick="switchPage('collection')" class="mt-4 md:mt-0 text-sm font-semibold text-titanium hover:text-white flex items-center space-x-2 group">
                            <span>Browse Full Showroom</span>
                            <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                        </button>
                    </div>

                    <div id="home-cars-grid" class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        <!-- Populated by JS -->
                    </div>
                </div>
            </section>

            <!-- Community Highlights & Testimonials -->
            <section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-2xl mx-auto mb-16">
                    <span class="text-racingred font-heading text-sm uppercase tracking-widest block mb-2">Driver Community</span>
                    <h2 class="font-heading text-4xl font-bold uppercase tracking-tight mb-4">Legends of NITRO X</h2>
                    <p class="text-titanium text-sm">Hear from elite pro racers and club leaders who dominate the global leaderboards.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="glass-panel p-8 rounded-2xl border border-white/10 relative">
                        <div class="flex items-center space-x-4 mb-6">
                            <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=150&q=80" alt="Avatar" class="w-12 h-12 rounded-full object-cover border border-racingred">
                            <div>
                                <h4 class="font-heading font-bold text-base">Alex "Vortex" Mercer</h4>
                                <span class="text-xs text-titanium">Leader of Apex Syndicate</span>
                            </div>
                        </div>
                        <p class="text-titanium text-sm italic">"The handling physics in NITRO X are unmatched. When you hit a perfect drift through the Mountain Pass at 180mph, nothing else compares."</p>
                    </div>
                    <div class="glass-panel p-8 rounded-2xl border border-white/10 relative">
                        <div class="flex items-center space-x-4 mb-6">
                            <img src="https://images.unsplash.com/photo-1570295999919-56ceb5ecca61?auto=format&fit=crop&w=150&q=80" alt="Avatar" class="w-12 h-12 rounded-full object-cover border border-racingred">
                            <div>
                                <h4 class="font-heading font-bold text-base">Elena Rostova</h4>
                                <span class="text-xs text-titanium">Season 3 World Champion</span>
                            </div>
                        </div>
                        <p class="text-titanium text-sm italic">"Customization is insanely deep. Tuning the suspension and aero downforce gave me the exact edge needed to secure the World Championship."</p>
                    </div>
                    <div class="glass-panel p-8 rounded-2xl border border-white/10 relative">
                        <div class="flex items-center space-x-4 mb-6">
                            <img src="https://images.unsplash.com/photo-1527980965255-d3b416303d12?auto=format&fit=crop&w=150&q=80" alt="Avatar" class="w-12 h-12 rounded-full object-cover border border-racingred">
                            <div>
                                <h4 class="font-heading font-bold text-base">Marcus Thorne</h4>
                                <span class="text-xs text-titanium">Pro Drift Streamer</span>
                            </div>
                        </div>
                        <p class="text-titanium text-sm italic">"The graphics engine looks like a next-gen cinematic movie. Racing at night in Neon City with ray-traced reflections is breathtaking."</p>
                    </div>
                </div>
            </section>
        </div>

        <!-- ================= PAGE 2: GAME WORLD ================= -->
        <div id="page-world" class="page-section hidden">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <span class="text-racingred font-heading text-sm uppercase tracking-widest block mb-2">Open-World Exploration</span>
                    <h1 class="font-heading text-4xl sm:text-6xl font-bold uppercase tracking-tight mb-4">The NITRO X Universe</h1>
                    <p class="text-titanium text-sm sm:text-base">Explore 6 meticulously crafted open-world environments, each featuring unique terrain, dynamic weather systems, and extreme racing challenges.</p>
                </div>

                <div id="worlds-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- Populated by JS -->
                </div>
            </div>
        </div>

        <!-- ================= PAGE 3: SHOWROOM / COLLECTION ================= -->
        <div id="page-collection" class="page-section hidden">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
                <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
                    <div>
                        <span class="text-racingred font-heading text-sm uppercase tracking-widest block mb-2">Virtual Showroom</span>
                        <h1 class="font-heading text-4xl sm:text-6xl font-bold uppercase tracking-tight">Ultimate Car Collection</h1>
                    </div>
                    <div class="mt-6 md:mt-0 flex flex-wrap gap-2" id="category-filters">
                        <button onclick="filterCars('All')" class="category-btn bg-racingred text-white px-4 py-2 rounded text-xs font-heading font-bold uppercase tracking-wider transition-all">All</button>
                        <button onclick="filterCars('Supercars')" class="category-btn bg-graphite hover:bg-surface text-titanium hover:text-white px-4 py-2 rounded text-xs font-heading font-bold uppercase tracking-wider transition-all">Supercars</button>
                        <button onclick="filterCars('Hypercars')" class="category-btn bg-graphite hover:bg-surface text-titanium hover:text-white px-4 py-2 rounded text-xs font-heading font-bold uppercase tracking-wider transition-all">Hypercars</button>
                        <button onclick="filterCars('Sports')" class="category-btn bg-graphite hover:bg-surface text-titanium hover:text-white px-4 py-2 rounded text-xs font-heading font-bold uppercase tracking-wider transition-all">Sports</button>
                        <button onclick="filterCars('Drift')" class="category-btn bg-graphite hover:bg-surface text-titanium hover:text-white px-4 py-2 rounded text-xs font-heading font-bold uppercase tracking-wider transition-all">Drift</button>
                        <button onclick="filterCars('Electric')" class="category-btn bg-graphite hover:bg-surface text-titanium hover:text-white px-4 py-2 rounded text-xs font-heading font-bold uppercase tracking-wider transition-all">Electric</button>
                    </div>
                </div>

                <!-- Cars Grid -->
                <div id="showroom-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- Populated by JS -->
                </div>
            </div>
        </div>

        <!-- ================= PAGE 4: GARAGE & CUSTOMIZER ================= -->
        <div id="page-garage" class="page-section hidden">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
                <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
                    <div>
                        <span class="text-racingred font-heading text-sm uppercase tracking-widest block mb-2">Interactive Virtual Workshop</span>
                        <h1 class="font-heading text-4xl sm:text-6xl font-bold uppercase tracking-tight">Garage & Customizer</h1>
                    </div>
                    <div class="mt-4 md:mt-0 flex items-center space-x-3">
                        <button onclick="switchPage('collection')" class="bg-graphite hover:bg-surface text-titanium hover:text-white px-4 py-2.5 rounded font-medium text-sm border border-white/10">Browse Showroom</button>
                        <button onclick="compareCarsModal()" class="bg-racingred hover:bg-racingredhover text-white px-4 py-2.5 rounded font-heading font-semibold text-sm uppercase tracking-wider">Side-by-Side Compare</button>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    <!-- 3D / Canvas Car Preview & Selector -->
                    <div class="lg:col-span-2 glass-panel p-6 rounded-2xl border border-white/10 flex flex-col justify-between">
                        <div class="flex items-center justify-between mb-4">
                            <div>
                                <h3 id="active-car-name" class="font-heading text-2xl font-bold uppercase">Apex V12 Phantom</h3>
                                <p id="active-car-category" class="text-xs text-racingred font-semibold uppercase tracking-widest">Hypercar Class</p>
                            </div>
                            <select id="garage-car-select" onchange="selectGarageCar(this.value)" class="bg-graphite text-white px-4 py-2 rounded border border-white/10 font-medium text-sm focus:outline-none">
                                <!-- Populated by JS -->
                            </select>
                        </div>

                        <!-- Canvas Viewer Container -->
                        <div class="relative w-full h-[380px] bg-obsidian rounded-xl overflow-hidden border border-white/10 flex items-center justify-center">
                            <canvas id="garage-canvas" class="w-full h-full block cursor-grab active:cursor-grabbing"></canvas>
                            <div class="absolute bottom-4 left-4 bg-obsidian/80 backdrop-blur px-3 py-1.5 rounded text-xs text-titanium border border-white/10">
                                <i class="fa-solid fa-arrows-rotate mr-1 text-racingred"></i> Drag to rotate 360° | Scroll to zoom
                            </div>
                        </div>

                        <!-- Stats Bars -->
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6">
                            <div class="bg-graphite/60 p-3 rounded-xl border border-white/10">
                                <span class="text-xs text-titanium uppercase block mb-1">Top Speed</span>
                                <div class="flex items-end justify-between"><span id="stat-speed" class="font-heading font-bold text-lg">248 MPH</span><span class="text-xs text-racingred font-bold">96/100</span></div>
                                <div class="w-full bg-surface rounded-full h-1.5 mt-2"><div id="bar-speed" class="bg-racingred h-1.5 rounded-full" style="width: 96%"></div></div>
                            </div>
                            <div class="bg-graphite/60 p-3 rounded-xl border border-white/10">
                                <span class="text-xs text-titanium uppercase block mb-1">Acceleration</span>
                                <div class="flex items-end justify-between"><span id="stat-accel" class="font-heading font-bold text-lg">2.1s (0-60)</span><span class="text-xs text-racingred font-bold">98/100</span></div>
                                <div class="w-full bg-surface rounded-full h-1.5 mt-2"><div id="bar-accel" class="bg-racingred h-1.5 rounded-full" style="width: 98%"></div></div>
                            </div>
                            <div class="bg-graphite/60 p-3 rounded-xl border border-white/10">
                                <span class="text-xs text-titanium uppercase block mb-1">Handling</span>
                                <div class="flex items-end justify-between"><span id="stat-handling" class="font-heading font-bold text-lg">94 G</span><span class="text-xs text-racingred font-bold">94/100</span></div>
                                <div class="w-full bg-surface rounded-full h-1.5 mt-2"><div id="bar-handling" class="bg-racingred h-1.5 rounded-full" style="width: 94%"></div></div>
                            </div>
                            <div class="bg-graphite/60 p-3 rounded-xl border border-white/10">
                                <span class="text-xs text-titanium uppercase block mb-1">Braking</span>
                                <div class="flex items-end justify-between"><span id="stat-braking" class="font-heading font-bold text-lg">100ft (60-0)</span><span class="text-xs text-racingred font-bold">92/100</span></div>
                                <div class="w-full bg-surface rounded-full h-1.5 mt-2"><div id="bar-braking" class="bg-racingred h-1.5 rounded-full" style="width: 92%"></div></div>
                            </div>
                        </div>
                    </div>

                    <!-- Customization Control Panel -->
                    <div class="glass-panel p-6 rounded-2xl border border-white/10 flex flex-col justify-between">
                        <div>
                            <h3 class="font-heading text-xl font-bold uppercase mb-4 flex items-center justify-between">
                                <span>Customizer</span>
                                <i class="fa-solid fa-wand-magic-sparkles text-racingred"></i>
                            </h3>

                            <div class="space-y-5 text-sm">
                                <!-- Body Paint -->
                                <div>
                                    <label class="text-xs uppercase tracking-wider text-titanium block mb-2 font-semibold">Body Paint & Finish</label>
                                    <div class="flex items-center space-x-3">
                                        <button onclick="setCarColor('#E63935')" class="w-8 h-8 rounded-full bg-[#E63935] ring-2 ring-white/50 focus:scale-110 transition-transform"></button>
                                        <button onclick="setCarColor('#191919')" class="w-8 h-8 rounded-full bg-[#191919] ring-2 ring-white/20 focus:scale-110 transition-transform"></button>
                                        <button onclick="setCarColor('#FFFFFF')" class="w-8 h-8 rounded-full bg-[#FFFFFF] ring-2 ring-white/20 focus:scale-110 transition-transform"></button>
                                        <button onclick="setCarColor('#3B82F6')" class="w-8 h-8 rounded-full bg-[#3B82F6] ring-2 ring-white/20 focus:scale-110 transition-transform"></button>
                                        <button onclick="setCarColor('#10B981')" class="w-8 h-8 rounded-full bg-[#10B981] ring-2 ring-white/20 focus:scale-110 transition-transform"></button>
                                        <button onclick="setCarColor('#F59E0B')" class="w-8 h-8 rounded-full bg-[#F59E0B] ring-2 ring-white/20 focus:scale-110 transition-transform"></button>
                                    </div>
                                </div>

                                <!-- Alloy Wheels -->
                                <div>
                                    <label class="text-xs uppercase tracking-wider text-titanium block mb-2 font-semibold">Alloy Wheels</label>
                                    <select id="mod-wheels" onchange="showToast('Wheel package updated!')" class="w-full bg-graphite text-white px-3 py-2 rounded border border-white/10 text-sm">
                                        <option>Forge Apex 20" Matte Black</option>
                                        <option>Titanium Multi-Spoke 21"</option>
                                        <option>Carbon Aero Blade 19"</option>
                                        <option>Gold Magnesium Track</option>
                                    </select>
                                </div>

                                <!-- Spoilers & Aero -->
                                <div>
                                    <label class="text-xs uppercase tracking-wider text-titanium block mb-2 font-semibold">Spoiler & Downforce</label>
                                    <select id="mod-spoiler" onchange="showToast('Aero downforce adjusted!')" class="w-full bg-graphite text-white px-3 py-2 rounded border border-white/10 text-sm">
                                        <option>GT Carbon Swan-Neck Wing</option>
                                        <option>Active Ducktail Lip</option>
                                        <option>Time Attack Extreme Wing</option>
                                        <option>Stock Factory Aero</option>
                                    </select>
                                </div>

                                <!-- Window Tint & Decals -->
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="text-xs uppercase tracking-wider text-titanium block mb-2 font-semibold">Window Tint</label>
                                        <select class="w-full bg-graphite text-white px-3 py-2 rounded border border-white/10 text-sm">
                                            <option>50% Limo Dark</option>
                                            <option>30% Medium</option>
                                            <option>Clear Stock</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="text-xs uppercase tracking-wider text-titanium block mb-2 font-semibold">Racing Decals</label>
                                        <select class="w-full bg-graphite text-white px-3 py-2 rounded border border-white/10 text-sm">
                                            <option>NITRO X Official Livery</option>
                                            <option>Vortex Racing Stripes</option>
                                            <option>Clean Minimalist</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- Engine Upgrade Stage -->
                                <div>
                                    <label class="text-xs uppercase tracking-wider text-titanium block mb-2 font-semibold">Engine & Turbo Tuning</label>
                                    <div class="grid grid-cols-3 gap-2">
                                        <button onclick="showToast('Stage 1 ECU Tune Applied')" class="bg-graphite hover:bg-surface border border-white/10 py-2 rounded text-xs font-heading font-bold uppercase text-titanium hover:text-white transition-all">Stage 1</button>
                                        <button onclick="showToast('Stage 2 Twin-Turbo Upgrade Applied')" class="bg-graphite hover:bg-surface border border-white/10 py-2 rounded text-xs font-heading font-bold uppercase text-titanium hover:text-white transition-all">Stage 2</button>
                                        <button onclick="showToast('Apex Race Spec Engine Installed!')" class="bg-racingred text-white py-2 rounded text-xs font-heading font-bold uppercase transition-all shadow">Race Spec</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="pt-6 mt-6 border-t border-white/10">
                            <button onclick="showToast('Custom setup saved to cloud profile!')" class="w-full bg-racingred hover:bg-racingredhover text-white py-3 rounded font-heading font-bold uppercase text-sm tracking-wider transition-all shadow glow-red">
                                Save Custom Configuration
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

