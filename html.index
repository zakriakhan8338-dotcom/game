                    <p class="text-xs text-titanium mb-4">${c1.price}</p>
                    <div class="space-y-2 text-xs text-left">
                        <div class="flex justify-between"><span>Top Speed:</span><strong>${c1.speed} MPH</strong></div>
                        <div class="flex justify-between"><span>0-60 Acceleration:</span><strong>${c1.accel}</strong></div>
                        <div class="flex justify-between"><span>Handling:</span><strong>${c1.handling}</strong></div>
                        <div class="flex justify-between"><span>Braking:</span><strong>${c1.braking}</strong></div>
                    </div>
                </div>
                <div class="glass-panel p-6 rounded-xl border border-white/10 text-center">
                    <img src="${c2.img}" alt="${c2.name}" class="w-full h-40 object-cover rounded-lg mb-4">
                    <h3 class="font-heading font-bold text-xl uppercase mb-2">${c2.name}</h3>
                    <p class="text-xs text-titanium mb-4">${c2.price}</p>
                    <div class="space-y-2 text-xs text-left">
                        <div class="flex justify-between"><span>Top Speed:</span><strong>${c2.speed} MPH</strong></div>
                        <div class="flex justify-between"><span>0-60 Acceleration:</span><strong>${c2.accel}</strong></div>
                        <div class="flex justify-between"><span>Handling:</span><strong>${c2.handling}</strong></div>
                        <div class="flex justify-between"><span>Braking:</span><strong>${c2.braking}</strong></div>
                    </div>
                </div>
            `;
            modal.classList.remove('hidden');
