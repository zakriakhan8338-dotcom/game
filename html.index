                <!-- User Profile Header Banner -->
                <div class="glass-panel p-8 rounded-2xl border border-white/10 mb-8 flex flex-col md:flex-row items-center justify-between gap-6">
                    <div class="flex items-center space-x-6">
                        <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=200&q=80" alt="Avatar" class="w-24 h-24 rounded-full object-cover border-2 border-racingred glow-red">
                        <div>
                            <div class="flex items-center space-x-3 mb-1">
                                <h1 id="dash-username" class="font-heading text-3xl font-bold uppercase">Alex "Vortex" Mercer</h1>
                                <span class="bg-racingred text-white text-xs px-2.5 py-0.5 rounded font-heading font-bold uppercase">VIP LVL 48</span>
                            </div>
                            <p class="text-titanium text-sm">Apex Syndicate Club Leader • Joined Jan 2024</p>
                            <div class="mt-3 flex items-center space-x-4 text-xs text-titanium">
                                <span>XP: <strong class="text-white">142,850 / 150,000</strong></span>
                                <span>Win Rate: <strong class="text-white">78.4%</strong></span>
                            </div>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-3">
                        <button onclick="showToast('Profile editing mode activated!')" class="bg-graphite hover:bg-surface text-titanium hover:text-white px-4 py-2.5 rounded font-medium text-sm border border-white/10">Edit Profile</button>
                        <button onclick="switchPage('garage')" class="bg-racingred hover:bg-racingredhover text-white px-5 py-2.5 rounded font-heading font-semibold text-sm uppercase tracking-wider">My Garage</button>
                    </div>
                </div>

                <!-- Stats Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
                    <div class="glass-panel p-6 rounded-2xl border border-white/10">
                        <span class="text-xs text-titanium uppercase block mb-1">Total Races Completed</span>
                        <div class="font-heading text-3xl font-bold">1,428</div>
                        <span class="text-xs text-green-500 mt-2 block"><i class="fa-solid fa-arrow-up mr-1"></i> +14 this week</span>
                    </div>
                    <div class="glass-panel p-6 rounded-2xl border border-white/10">
                        <span class="text-xs text-titanium uppercase block mb-1">Total Wins</span>
                        <div class="font-heading text-3xl font-bold text-racingred">1,120</div>
                        <span class="text-xs text-titanium mt-2 block">78.4% Win Ratio</span>
                    </div>
                    <div class="glass-panel p-6 rounded-2xl border border-white/10">
                        <span class="text-xs text-titanium uppercase block mb-1">Best Lap Record</span>
                        <div class="font-heading text-3xl font-bold">1:14.282</div>
                        <span class="text-xs text-titanium mt-2 block">Neon City Circuit</span>
                    </div>
                    <div class="glass-panel p-6 rounded-2xl border border-white/10">
                        <span class="text-xs text-titanium uppercase block mb-1">Total Distance Driven</span>
                        <div class="font-heading text-3xl font-bold">42,890 mi</div>
                        <span class="text-xs text-titanium mt-2 block">Equiv. 1.7x Around Earth</span>
                    </div>
