        // Page Navigation
        function switchPage(pageId) {
            document.querySelectorAll('.page-section').forEach(el => el.classList.add('hidden'));
            const target = document.getElementById('page-' + pageId);
            if (target) {
                target.classList.remove('hidden');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
            document.querySelectorAll('.nav-link').forEach(btn => {
                if (btn.getAttribute('data-page') === pageId) {
                    btn.classList.add('text-white', 'border-b-2', 'border-racingred');
                } else {
                    btn.classList.remove('text-white', 'border-b-2', 'border-racingred');
                }
            });
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        // Toast Notifications
        function showToast(message) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'glass-panel px-5 py-3 rounded-xl border border-white/20 text-xs font-semibold text-white shadow-xl flex items-center space-x-3 transform translate-y-4 opacity-0 transition-all duration-300';
            toast.innerHTML = `<i class="fa-solid fa-circle-check text-racingred"></i><span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => { toast.classList.remove('translate-y-4', 'opacity-0'); }, 50);
            setTimeout(() => {
                toast.classList.add('translate-y-4', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Initialize Dynamic Content
        function initApp() {
            // Home Popular Cars
            const homeGrid = document.getElementById('home-cars-grid');
            if (homeGrid) {
                homeGrid.innerHTML = carsData.slice(0, 3).map(car => `
                    <div class="glass-panel rounded-2xl overflow-hidden border border-white/10 group">
                        <div class="relative h-56 overflow-hidden">
                            <img src="${car.img}" alt="${car.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <span class="absolute top-4 left-4 bg-obsidian/80 backdrop-blur text-xs font-heading font-bold px-3 py-1 rounded text-titanium border border-white/10 uppercase">${car.category}</span>
                        </div>
                        <div class="p-6">
                            <h3 class="font-heading text-xl font-bold uppercase mb-1">${car.name}</h3>
                            <p class="text-xs text-titanium mb-4">${car.desc}</p>
                            <div class="flex items-center justify-between text-xs font-semibold text-titanium pt-4 border-t border-white/10">
                                <span>Top Speed: <strong class="text-white">${car.speed} MPH</strong></span>
                                <button onclick="switchPage('garage')" class="text-racingred hover:text-white flex items-center space-x-1"><span>Customize</span><i class="fa-solid fa-arrow-right text-[10px]"></i></button>
                            </div>
                        </div>
                    </div>
                `).join('');
            }

            // Game Worlds Grid
            const worldsGrid = document.getElementById('worlds-grid');
            if (worldsGrid) {
                worldsGrid.innerHTML = worldsData.map(w => `
                    <div class="glass-panel rounded-2xl overflow-hidden border border-white/10 group flex flex-col justify-between">
                        <div>
                            <div class="relative h-52 overflow-hidden">
                                <img src="${w.img}" alt="${w.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                <span class="absolute top-4 left-4 bg-obsidian/80 backdrop-blur text-xs font-heading font-bold px-3 py-1 rounded text-titanium border border-white/10 uppercase">${w.diff}</span>
                            </div>
                            <div class="p-6">
                                <h3 class="font-heading text-2xl font-bold uppercase mb-2">${w.name}</h3>
                                <p class="text-titanium text-xs mb-4 leading-relaxed">${w.desc}</p>
                                <div class="space-y-2 text-xs text-titanium">
                                    <div class="flex justify-between"><span>Weather:</span><strong class="text-white">${w.weather}</strong></div>
                                    <div class="flex justify-between"><span>Modes:</span><strong class="text-white">${w.modes}</strong></div>
                                </div>
                            </div>
                        </div>
                        <div class="p-6 pt-0">
                            <button onclick="openGameModal()" class="w-full bg-graphite hover:bg-racingred text-white py-2.5 rounded font-heading font-bold text-xs uppercase tracking-wider transition-all border border-white/10">
                                Enter World
                            </button>
                        </div>
                    </div>
                `).join('');
            }

            // Showroom Cars Grid
            renderShowroomCars(carsData);

            // Garage Select Dropdown
            const garageSelect = document.getElementById('garage-car-select');
            if (garageSelect) {
                garageSelect.innerHTML = carsData.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
            }

            // Racing Modes Grid
            const modesGrid = document.getElementById('modes-grid');
            if (modesGrid) {
                modesGrid.innerHTML = modesData.map(m => `
                    <div class="glass-panel rounded-2xl overflow-hidden border border-white/10 group flex flex-col justify-between">
                        <div>
                            <div class="relative h-44 overflow-hidden">
                                <img src="${m.img}" alt="${m.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                <span class="absolute top-4 left-4 bg-obsidian/80 backdrop-blur text-xs font-heading font-bold px-3 py-1 rounded text-titanium border border-white/10 uppercase">${m.diff}</span>
