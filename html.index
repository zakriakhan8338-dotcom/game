    <!-- ================= FULLY PLAYABLE 3D RACING GAME MODAL ================= -->
    <div id="game-modal" class="fixed inset-0 z-50 hidden bg-obsidian/95 backdrop-blur-xl flex flex-col items-center justify-center p-4">
        <div class="max-w-5xl w-full flex items-center justify-between mb-4">
            <div class="flex items-center space-x-3">
                <div class="w-8 h-8 rounded bg-racingred flex items-center justify-center font-heading font-bold text-base italic tracking-tighter">NX</div>
                <div>
                    <h3 class="font-heading font-bold text-lg uppercase">NITRO X: Apex Circuit Simulator</h3>
                    <span class="text-xs text-titanium">Controls: W/Up = Accelerate | S/Down = Brake | A/D or Left/Right = Steer | Space = Nitro Boost</span>
                </div>
            </div>
            <button onclick="closeGameModal()" class="text-titanium hover:text-white text-xl p-2"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <div class="relative w-full max-w-5xl h-[550px] bg-graphite rounded-2xl overflow-hidden border border-white/20 shadow-2xl flex flex-col items-center justify-center">
            <!-- Canvas for Racing Game -->
            <canvas id="racing-game-canvas" class="w-full h-full block"></canvas>

            <!-- HUD Overlay inside game -->
            <div class="absolute top-6 left-6 flex space-x-6 pointer-events-none">
                <div class="glass-panel px-4 py-2 rounded-lg border border-white/10 text-center">
                    <span class="text-[10px] text-titanium uppercase block">Speed</span>
                    <span id="hud-speed" class="font-heading font-bold text-2xl text-white">0</span> <span class="text-xs text-titanium">MPH</span>
                </div>
                <div class="glass-panel px-4 py-2 rounded-lg border border-white/10 text-center">
                    <span class="text-[10px] text-titanium uppercase block">Lap Time</span>
                    <span id="hud-time" class="font-heading font-bold text-2xl text-racingred">00:00.0</span>
                </div>
                <div class="glass-panel px-4 py-2 rounded-lg border border-white/10 text-center">
                    <span class="text-[10px] text-titanium uppercase block">Nitro Boost</span>
                    <div class="w-24 bg-surface rounded-full h-2 mt-2"><div id="hud-nitro" class="bg-racingred h-2 rounded-full" style="width: 100%"></div></div>
                </div>
            </div>

            <!-- Start Game Overlay -->
            <div id="game-start-overlay" class="absolute inset-0 bg-obsidian/80 backdrop-blur-sm flex flex-col items-center justify-center text-center p-6">
                <h2 class="font-heading text-4xl font-bold uppercase mb-3 text-white">Ready to Race?</h2>
                <p class="text-titanium text-sm max-w-md mb-2">Use your keyboard to drive: <strong>W/S</strong> or <strong>Arrow Up/Down</strong> to throttle & brake, <strong>A/D</strong> or <strong>Arrow Left/Right</strong> to steer, and <strong>Spacebar</strong> for Nitro Boost!</p>
                <button onclick="startRacingGameSession()" class="mt-4 bg-racingred hover:bg-racingredhover text-white px-8 py-4 rounded font-heading font-bold uppercase tracking-wider text-base shadow-xl glow-red">
                    Start Engine & Launch
                </button>
            </div>

            <!-- Finish Screen Overlay -->
            <div id="game-finish-overlay" class="absolute inset-0 bg-obsidian/90 backdrop-blur-md hidden flex flex-col items-center justify-center text-center p-6">
                <div class="w-16 h-16 rounded-full bg-racingred/20 text-racingred flex items-center justify-center text-3xl mb-4 glow-red">
                    <i class="fa-solid fa-trophy"></i>
                </div>
                <h2 class="font-heading text-3xl font-bold uppercase mb-2">Race Finished!</h2>
                <p id="finish-time-text" class="text-titanium text-sm mb-6">Your Lap Time: 1:18.42s • Rewards: +1,500 XP & $10,000</p>
                <button onclick="restartRacingGame()" class="bg-racingred hover:bg-racingredhover text-white px-6 py-3 rounded font-heading font-bold uppercase tracking-wider text-sm">
                    Race Again
                </button>
            </div>
        </div>
    </div>

