            }

            // News Grid
            const newsGrid = document.getElementById('news-grid');
            if (newsGrid) {
                newsGrid.innerHTML = newsData.map(n => `
                    <div class="glass-panel rounded-2xl overflow-hidden border border-white/10 group flex flex-col justify-between">
                        <div>
