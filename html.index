                        </div>
                    </div>
                `).join('');
            }

            // Clubs List
            const clubsList = document.getElementById('clubs-list');
            if (clubsList) {
                clubsList.innerHTML = clubsData.map(c => `
                    <div class="glass-panel p-6 rounded-2xl border border-white/10 flex items-center justify-between">
                        <div>
                            <div class="flex items-center space-x-3 mb-1">
                                <h4 class="font-heading text-lg font-bold uppercase">${c.name}</h4>
                                <span class="bg-racingred text-white text-[10px] px-2 py-0.5 rounded font-bold uppercase">${c.rank}</span>
                            </div>
                            <p class="text-xs text-titanium mb-2">${c.desc}</p>
                            <span class="text-[10px] text-titanium">Leader: ${c.leader} • Members: ${c.members}</span>
                        </div>
