                        <button onclick="switchLeaderboardTab('drift')" class="lb-tab bg-graphite text-titanium hover:text-white px-4 py-2 rounded text-xs font-heading font-bold uppercase">Drift Masters</button>
                        <button onclick="switchLeaderboardTab('laps')" class="lb-tab bg-graphite text-titanium hover:text-white px-4 py-2 rounded text-xs font-heading font-bold uppercase">Fastest Laps</button>
                    </div>
