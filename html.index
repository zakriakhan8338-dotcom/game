                            </div>
                            <div class="p-6">
                                <span class="text-[10px] text-titanium block mb-2">${n.date}</span>
                                <h3 class="font-heading text-xl font-bold uppercase mb-2">${n.title}</h3>
                                <p class="text-titanium text-xs leading-relaxed mb-4">${n.excerpt}</p>
                            </div>
                        </div>
                        <div class="p-6 pt-0">
                            <button onclick="showToast('Loading full article editorial...')" class="text-xs font-semibold text-racingred hover:text-white flex items-center space-x-2">
                                <span>Read Full Article</span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                `).join('');
            }

            // FAQ Accordion
            const faqContainer = document.getElementById('faq-accordion');
            if (faqContainer) {
                faqContainer.innerHTML = faqData.map(f => `
                    <div class="glass-panel p-6 rounded-2xl border border-white/10">
                        <h3 class="font-heading font-bold text-base uppercase mb-2 text-white flex items-center justify-between">
