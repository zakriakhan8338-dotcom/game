                    { track: 'Mountain Pass Drift Sprint', car: 'Silvia S15', pos: '1st Place', time: '2:05.10', reward: '+$18,000' },
                    { track: 'Desert Run Time Attack', car: 'Spectre Electric R', pos: '2nd Place', time: '1:31.90', reward: '+$10,000' },
                    { track: 'Industrial Zone Street Race', car: 'Vortex GT9', pos: '1st Place', time: '1:19.45', reward: '+$22,000' }
                ].map(h => `
                    <div class="bg-graphite/60 p-4 rounded-xl border border-white/5 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
                        <div>
                            <strong class="text-white text-sm font-heading block">${h.track}</strong>
                            <span class="text-titanium">Car: ${h.car}</span>
