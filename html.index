                <div class="glass-panel rounded-2xl border border-white/10 overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="border-b border-white/10 text-xs text-titanium font-heading uppercase tracking-wider bg-graphite/50">
                                    <th class="py-4 px-6">Rank</th>
                                    <th class="py-4 px-6">Driver</th>
                                    <th class="py-4 px-6">Country</th>
                                    <th class="py-4 px-6">Favorite Car</th>
                                    <th class="py-4 px-6">Wins / Races</th>
                                    <th class="py-4 px-6 text-right">Rating / Points</th>
                                </tr>
