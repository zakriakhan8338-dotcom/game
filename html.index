        function closeCompareModal() {
            document.getElementById('compare-modal').classList.add('hidden');
        }

        // Authentication simulation
        function handleLoginSuccess() {
            showToast('Successfully signed in as Alex Mercer!');
            document.getElementById('nav-user-label').textContent = 'Alex Mercer';
            switchPage('dashboard');
        }

        // Chat simulation
        function sendChatMessage() {
            const input = document.getElementById('chat-input');
            const chatMessages = document.getElementById('chat-messages');
            if (!input.value.trim()) return;
            const msg = document.createElement('div');
            msg.className = 'bg-graphite/60 p-2.5 rounded border border-white/5';
            msg.innerHTML = `<span class="text-racingred font-bold">You:</span> ${input.value}`;
            chatMessages.appendChild(msg);
            input.value = '';
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        // ================= FULLY PLAYABLE 3D/CANVAS RACING GAME =================
        let gameActive = false;
        let gameAnimationId = null;
        let gameCanvas, gameCtx;
        let carPos = { x: 400, y: 420, speed: 0, maxSpeed: 12, angle: 0 };
        let keys = {};
        let obstacles = [];
        let gameStartTime = 0;
        let nitroAmount = 100;
        let gameScore = 0;

        function openGameModal() {
            document.getElementById('game-modal').classList.remove('hidden');
            document.getElementById('game-start-overlay').classList.remove('hidden');
            document.getElementById('game-finish-overlay').classList.add('hidden');
            initRacingGameCanvas();
        }

        function closeGameModal() {
            document.getElementById('game-modal').classList.add('hidden');
            gameActive = false;
            if (gameAnimationId) cancelAnimationFrame(gameAnimationId);
        }

        function initRacingGameCanvas() {
            gameCanvas = document.getElementById('racing-game-canvas');
            if (!gameCanvas) return;
            gameCtx = gameCanvas.getContext('2d');
            gameCanvas.width = gameCanvas.parentElement.clientWidth || 900;
            gameCanvas.height = gameCanvas.parentElement.clientHeight || 520;

            window.addEventListener('keydown', (e) => {
                keys[e.code] = true;
                if(['Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.code)) {
                    e.preventDefault(); // Prevent page scrolling while playing
                }
            });
            window.addEventListener('keyup', (e) => {
                keys[e.code] = false;
            });
        }

        function startRacingGameSession() {
            document.getElementById('game-start-overlay').classList.add('hidden');
            gameActive = true;
            gameStartTime = Date.now();
            carPos = { x: gameCanvas.width / 2, y: gameCanvas.height - 100, speed: 0, maxSpeed: 14, angle: 0 };
            obstacles = [];
            nitroAmount = 100;
            gameScore = 0;

            for (let i = 0; i < 5; i++) {
                obstacles.push({
                    x: Math.random() * (gameCanvas.width - 200) + 100,
                    y: -i * 200 - 150,
                    width: 50,
                    height: 90,
                    speed: 4 + Math.random() * 3
                });
            }

            runGameLoop();
        }

        function runGameLoop() {
            if (!gameActive) return;

            // Keyboard Physics Inputs
            if (keys['ArrowUp'] || keys['KeyW']) {
                if (carPos.speed < carPos.maxSpeed) carPos.speed += 0.25;
            } else if (keys['ArrowDown'] || keys['KeyS']) {
                if (carPos.speed > -4) carPos.speed -= 0.35;
            } else {
                carPos.speed *= 0.96; // Natural deceleration
            }

            if (keys['ArrowLeft'] || keys['KeyA']) {
                carPos.x -= 7;
            }
            if (keys['ArrowRight'] || keys['KeyD']) {
                carPos.x += 7;
            }

            // Nitro Boost (Spacebar)
            if (keys['Space'] && nitroAmount > 0) {
                carPos.maxSpeed = 24;
                nitroAmount -= 1.5;
            } else {
                carPos.maxSpeed = 14;
                if (nitroAmount < 100) nitroAmount += 0.15;
            }

            // Screen Boundaries
            if (carPos.x < 150) carPos.x = 150;
            if (carPos.x > gameCanvas.width - 150) carPos.x = gameCanvas.width - 150;

            // Obstacles logic
            obstacles.forEach(obs => {
                obs.y += carPos.speed + obs.speed;
                if (obs.y > gameCanvas.height + 100) {
                    obs.y = -200 - Math.random() * 200;
                    obs.x = Math.random() * (gameCanvas.width - 300) + 150;
                    gameScore += 100;
                }

                if (Math.abs(carPos.x - obs.x) < 35 && Math.abs(carPos.y - obs.y) < 70) {
                    carPos.speed = 2;
                    nitroAmount = Math.max(0, nitroAmount - 25);
                }
            });

            // Render Frame
            gameCtx.clearRect(0, 0, gameCanvas.width, gameCanvas.height);

            // Road Asphalt
            gameCtx.fillStyle = '#111111';
            gameCtx.fillRect(100, 0, gameCanvas.width - 200, gameCanvas.height);

            // Red Side Barriers
            gameCtx.fillStyle = '#E63935';
            gameCtx.fillRect(95, 0, 8, gameCanvas.height);
            gameCtx.fillRect(gameCanvas.width - 103, 0, 8, gameCanvas.height);

            // Center Dashes
            gameCtx.fillStyle = '#FFFFFF';
            const dashOffset = (Date.now() * 0.5 * (carPos.speed + 2)) % 60;
            for (let y = -60 + dashOffset; y < gameCanvas.height; y += 60) {
                gameCtx.fillRect(gameCanvas.width / 2 - 4, y, 8, 30);
            }

            // Draw Obstacles
            obstacles.forEach(obs => {
                gameCtx.fillStyle = '#E63935';
                gameCtx.beginPath();
                gameCtx.roundRect(obs.x - 25, obs.y - 45, 50, 90, 8);
                gameCtx.fill();
                gameCtx.fillStyle = '#090909';
                gameCtx.fillRect(obs.x - 20, obs.y - 20, 40, 25);
            });

            // Draw Player Car
            gameCtx.fillStyle = '#FFFFFF';
            gameCtx.beginPath();
            gameCtx.roundRect(carPos.x - 28, carPos.y - 50, 56, 100, 10);
            gameCtx.fill();
            gameCtx.fillStyle = '#090909';
            gameCtx.fillRect(carPos.x - 22, carPos.y - 25, 44, 30);

            // Update HUD UI
            document.getElementById('hud-speed').textContent = Math.round(carPos.speed * 15);
            const elapsed = ((Date.now() - gameStartTime) / 1000).toFixed(1);
            document.getElementById('hud-time').textContent = elapsed + 's';
            document.getElementById('hud-nitro').style.width = nitroAmount + '%';

            if (gameScore >= 2500) {
                gameActive = false;
                document.getElementById('finish-time-text').textContent = `Lap Time: ${elapsed}s • Score: ${gameScore} PTS • Rewards: +2,500 XP & $30,000`;
                document.getElementById('game-finish-overlay').classList.remove('hidden');
                return;
            }

            gameAnimationId = requestAnimationFrame(runGameLoop);
        }

        function restartRacingGame() {
            document.getElementById('game-finish-overlay').classList.add('hidden');
            startRacingGameSession();
        }

        window.onload = function() {
            initApp();
        };
    </script>
</body>
</html>
