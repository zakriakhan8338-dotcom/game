        function renderShowroomCars(list) {
            const grid = document.getElementById('showroom-grid');
            if (!grid) return;
            grid.innerHTML = list.map(car => `
                <div class="glass-panel rounded-2xl overflow-hidden border border-white/10 group flex flex-col justify-between">
                    <div>
                        <div class="relative h-56 overflow-hidden">
                            <img src="${car.img}" alt="${car.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            <span class="absolute top-4 left-4 bg-obsidian/80 backdrop-blur text-xs font-heading font-bold px-3 py-1 rounded text-titanium border border-white/10 uppercase">${car.category}</span>
                            <span class="absolute bottom-4 right-4 bg-racingred text-white text-xs font-heading font-bold px-3 py-1 rounded shadow">${car.price}</span>
                        </div>
                        <div class="p-6">
                            <h3 class="font-heading text-xl font-bold uppercase mb-1">${car.name}</h3>
                            <p class="text-xs text-titanium mb-4">${car.desc}</p>
                            <div class="grid grid-cols-2 gap-2 text-xs text-titanium pt-4 border-t border-white/10">
                                <span>Speed: <strong class="text-white">${car.speed} MPH</strong></span>
                                <span>0-60: <strong class="text-white">${car.accel}</strong></span>
                            </div>
                        </div>
                    </div>
                    <div class="p-6 pt-0 flex gap-2">
                        <button onclick="switchPage('garage'); selectGarageCar('${car.id}');" class="flex-1 bg-racingred hover:bg-racingredhover text-white py-2.5 rounded font-heading font-bold text-xs uppercase tracking-wider transition-all">
                            Customize in Garage
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function filterCars(cat) {
            document.querySelectorAll('.category-btn').forEach(btn => {
                if (btn.textContent.trim() === cat) {
                    btn.classList.remove('bg-graphite', 'text-titanium');
                    btn.classList.add('bg-racingred', 'text-white');
                } else {
                    btn.classList.remove('bg-racingred', 'text-white');
                    btn.classList.add('bg-graphite', 'text-titanium');
                }
            });
            if (cat === 'All') {
                renderShowroomCars(carsData);
            } else {
                renderShowroomCars(carsData.filter(c => c.category === cat));
            }
        }

        function renderLeaderboard(type) {
            const tbody = document.getElementById('leaderboard-table-body');
            if (!tbody) return;
            tbody.innerHTML = leaderboardData.map(l => `
                <tr class="hover:bg-graphite/40 transition-colors">
                    <td class="py-4 px-6 font-heading font-bold text-racingred">#${l.rank}</td>
                    <td class="py-4 px-6 font-medium text-white flex items-center space-x-3">
                        <img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=100&q=80" alt="Avatar" class="w-8 h-8 rounded-full object-cover">
                        <span>${l.name}</span>
                    </td>
                    <td class="py-4 px-6 text-xl">${l.country}</td>
                    <td class="py-4 px-6 text-titanium">${l.car}</td>
                    <td class="py-4 px-6 text-titanium">${l.wins}</td>
                    <td class="py-4 px-6 text-right font-heading font-bold text-white">${l.rating}</td>
                </tr>
            `).join('');
        }

        function switchLeaderboardTab(tab) {
            document.querySelectorAll('.lb-tab').forEach(b => {
                b.classList.remove('bg-racingred', 'text-white');
                b.classList.add('bg-graphite', 'text-titanium');
            });
            event.target.classList.remove('bg-graphite', 'text-titanium');
            event.target.classList.add('bg-racingred', 'text-white');
            renderLeaderboard(tab);
        }

        // Three.js Garage Viewer Setup
        let garageScene, garageCamera, garageRenderer, garageCarMesh;
        function initGarageViewer() {
            const container = document.getElementById('garage-canvas');
            if (!container) return;
            const width = container.clientWidth || 600;
            const height = container.clientHeight || 380;

            garageScene = new THREE.Scene();
            garageCamera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
            garageCamera.position.set(0, 3, 7);
            garageCamera.lookAt(0, 0, 0);

            garageRenderer = new THREE.WebGLRenderer({ canvas: container, antialias: true, alpha: true });
            garageRenderer.setSize(width, height);
            garageRenderer.setPixelRatio(window.devicePixelRatio);

            // Lighting
            const ambientLight = new THREE.AmbientLight(0xffffff, 1.2);
            garageScene.add(ambientLight);

            const dirLight = new THREE.DirectionalLight(0xe63935, 2.5);
            dirLight.position.set(5, 10, 7);
            garageScene.add(dirLight);

            const blueLight = new THREE.DirectionalLight(0x3b82f6, 1.5);
            blueLight.position.set(-5, -5, -5);
            garageScene.add(blueLight);

            // Create a stylized futuristic 3D car model using basic geometries
            const carGroup = new THREE.Group();

            // Body
            const bodyMat = new THREE.MeshStandardMaterial({ color: 0xe63935, roughness: 0.2, metalness: 0.9 });
            const bodyGeo = new THREE.BoxGeometry(2.4, 0.6, 4.2);
            const body = new THREE.Mesh(bodyGeo, bodyMat);
            body.position.y = 0.4;
            carGroup.add(body);

            // Cabin / Roof
            const cabinMat = new THREE.MeshStandardMaterial({ color: 0x111111, roughness: 0.1, metalness: 0.9 });
            const cabinGeo = new THREE.BoxGeometry(1.8, 0.5, 2.0);
            const cabin = new THREE.Mesh(cabinGeo, cabinMat);
            cabin.position.set(0, 0.85, -0.2);
            carGroup.add(cabin);

            // Wheels
            const wheelMat = new THREE.MeshStandardMaterial({ color: 0x222222, roughness: 0.5 });
            const wheelGeo = new THREE.CylinderGeometry(0.4, 0.4, 0.3, 32);
            wheelGeo.rotateZ(Math.PI / 2);

            const w1 = new THREE.Mesh(wheelGeo, wheelMat);
            w1.position.set(1.2, 0.3, 1.4);
            carGroup.add(w1);

            const w2 = new THREE.Mesh(wheelGeo, wheelMat);
            w2.position.set(-1.2, 0.3, 1.4);
            carGroup.add(w2);

            const w3 = new THREE.Mesh(wheelGeo, wheelMat);
            w3.position.set(1.2, 0.3, -1.4);
            carGroup.add(w3);

            const w4 = new THREE.Mesh(wheelGeo, wheelMat);
            w4.position.set(-1.2, 0.3, -1.4);
            carGroup.add(w4);

            garageCarMesh = carGroup;
            garageScene.add(garageCarMesh);

            // Mouse rotation handlers
            let isDragging = false;
            let prevMouseX = 0;

            container.addEventListener('mousedown', (e) => { isDragging = true; prevMouseX = e.clientX; });
            window.addEventListener('mouseup', () => { isDragging = false; });
            window.addEventListener('mousemove', (e) => {
                if (!isDragging || !garageCarMesh) return;
                const deltaX = e.clientX - prevMouseX;
                garageCarMesh.rotation.y += deltaX * 0.01;
                prevMouseX = e.clientX;
            });

            // Touch events for mobile
            container.addEventListener('touchstart', (e) => { isDragging = true; prevMouseX = e.touches[0].clientX; });
            window.addEventListener('touchend', () => { isDragging = false; });
            window.addEventListener('touchmove', (e) => {
                if (!isDragging || !garageCarMesh) return;
                const deltaX = e.touches[0].clientX - prevMouseX;
                garageCarMesh.rotation.y += deltaX * 0.01;
                prevMouseX = e.touches[0].clientX;
            });

            animateGarage();
        }

        function animateGarage() {
            requestAnimationFrame(animateGarage);
            if (garageCarMesh && !document.getElementById('page-garage').classList.contains('hidden')) {
                garageCarMesh.rotation.y += 0.005; // Gentle automatic 360 spin
            }
            if (garageRenderer && garageScene && garageCamera) {
                garageRenderer.render(garageScene, garageCamera);
            }
        }

        function selectGarageCar(carId) {
            const car = carsData.find(c => c.id === carId);
            if (!car) return;
            document.getElementById('active-car-name').textContent = car.name;
            document.getElementById('active-car-category').textContent = car.category + ' Class';
            document.getElementById('stat-speed').textContent = car.speed + ' MPH';
            document.getElementById('stat-accel').textContent = car.accel + ' (0-60)';
            document.getElementById('stat-handling').textContent = car.handling;
            document.getElementById('stat-braking').textContent = car.braking;
            showToast(`Loaded ${car.name} into virtual bay`);
        }

        function setCarColor(colorHex) {
            if (garageCarMesh) {
                garageCarMesh.children[0].material.color.set(colorHex);
                showToast('Body paint color updated!');
            }
        }

        // Side-by-side Car Comparison Modal
